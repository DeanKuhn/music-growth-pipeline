# All server-only — never prefix with NEXT_PUBLIC_. Never put the owner
# DATABASE_URL here; app_readonly only.
DATABASE_URL_READONLY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
IP_HASH_SALT=
REVALIDATE_SECRET=
# Public custom domain, e.g. https://music.deanslist.dev — used for pages'
# self-fetch of their own /api/* routes. Leave unset locally (falls back to
# localhost); required in Vercel prod, see lib/api.ts getBaseUrl().
SITE_URL=
